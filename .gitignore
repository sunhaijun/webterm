# Go
/bin/
/dist/
*.exe
*.test
*.out

# Node / frontend build output
node_modules/
web/dist/
.vite/

# Embedded frontend, generated by `npm run build`. Keep .gitkeep: go:embed fails
# to compile when the directory is missing.
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# Runtime data
*.db
*.db-wal
*.db-shm
/.webterm/

# Test and tool output
/coverage/
/playwright-report/
/test-results/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code worktrees
/.claude/worktrees/

# Local build output
/webterm
/release/

# Python bytecode (scripts/)
__pycache__/
