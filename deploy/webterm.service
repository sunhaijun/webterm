# webterm as a systemd system service running as a regular user (ADR-0034).
# scripts/install.sh generates this for you; see docs/80-ops/systemd.md.
#
# To install by hand, replace `alice` and `1000` with your user name and `id -u`
# (the UID must be literal: %U in a system unit is PID 1's UID, i.e. 0), set
# --domain, then:
#   sudo cp deploy/webterm.service /etc/systemd/system/
#   sudo setcap 'cap_net_bind_service=+ep' /usr/local/bin/webterm   # again after every binary update
#   sudo systemctl daemon-reload && sudo systemctl enable --now webterm
#   sudo loginctl enable-linger $USER   # keeps your user manager (systemctl --user in sessions)
#
# A system service rather than a user service because of OOM priority: a user
# service can't go below oom_score_adj 100, so it would be killed before your login.
#
# No ProtectHome/ProtectSystem/NoNewPrivileges/PrivateTmp on purpose: they would
# confine the shells you open, and NoNewPrivileges breaks sudo. Running as a regular
# user is the hardening that counts (docs/60-security/threat-model.md).

[Unit]
Description=webterm — browser terminal agent
Documentation=https://github.com/sunhaijun/webterm
After=network-online.target user@1000.service
Wants=network-online.target user@1000.service

[Service]
Type=simple
User=alice
Group=alice
ExecStart=/usr/local/bin/webterm serve --domain term.example.com
Restart=on-failure
RestartSec=3

# For systemctl --user, journalctl --user and D-Bus tools inside sessions.
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

# The agent is the OOM killer's last choice; sessions run at 0. "continue": an
# OOM-killed process in one session doesn't stop the unit.
OOMScoreAdjust=-900
OOMPolicy=continue

# Hot upgrade (ADR-0016): re-exec the new binary in place; sessions survive.
ExecReload=/bin/kill -USR2 $MAINPID

# Give the agent time to tell clients it's going away.
KillSignal=SIGTERM
TimeoutStopSec=15
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=webterm

[Install]
WantedBy=multi-user.target
