# webterm 系统服务 —— 以【普通用户】运行（ADR-0034）。scripts/install.sh 会替你生成这一份。
#
# 手工安装：把下面的 sun / 1000 换成你的用户名与 `id -u`（uid 不能写 %U ——
# 系统单元里它是 PID 1 的 UID，也就是 0），改掉 --domain，然后：
#   sudo cp deploy/webterm.service /etc/systemd/system/
#   sudo setcap 'cap_net_bind_service=+ep' /usr/local/bin/webterm
#   sudo systemctl daemon-reload && sudo systemctl enable --now webterm
#   sudo loginctl enable-linger $USER      # 让用户管理器常驻：会话里的 systemctl --user 要用
#
# 为什么是系统服务而不是 ~/.config/systemd/user：OOM 优先级。用户服务的
# oom_score_adj 最低 100，内存一紧就比登录会话先被杀，所有会话跟着没了。
#
# 完整说明见 docs/80-ops/systemd.md。
# 注意：每次替换二进制后 setcap 都要重做（capability 附在文件上，不在路径上）。

[Unit]
Description=webterm — browser terminal agent
Documentation=https://github.com/sunhaijun/webterm
After=network-online.target user@1000.service
Wants=network-online.target user@1000.service

[Service]
Type=simple
User=sun
Group=sun
ExecStart=/usr/local/bin/webterm serve --domain term.example.com
Restart=on-failure
RestartSec=3

# 会话里的 systemctl --user / journalctl --user / 走 D-Bus 的工具要用
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

# OOM（ADR-0034）：agent 最后才被挑，起 shell 时它把会话设回 0；
# continue：会话里某个进程被 OOM 杀掉只死它自己，不会停掉整个 unit
OOMScoreAdjust=-900
OOMPolicy=continue

# 热升级（ADR-0016）：reload = 原地 exec 新二进制，会话保留
ExecReload=/bin/kill -USR2 $MAINPID

# 优雅关闭：给 agent 时间广播"即将重启"并关闭会话
KillSignal=SIGTERM
TimeoutStopSec=15
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=webterm

# 刻意【不】启用 ProtectHome / ProtectSystem / NoNewPrivileges / PrivateTmp：
# 它们会连会话里的 shell 一起限制，而用户开 webterm 就是为了操作自己的文件；
# NoNewPrivileges 还会让 sudo 失效。沙箱化 shell 是自欺欺人 —— 用户本来就有
# 这台机器的 shell 权限。唯一有效的加固是以普通用户运行（见 threat-model.md）。

[Install]
WantedBy=multi-user.target
