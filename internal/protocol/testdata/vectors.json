{
  "_comment": "前后端共用的 fixture。Go 侧 internal/protocol 与 TS 侧 web/src/protocol 都必须跑它，防止实现漂移。契约见 docs/30-protocol/websocket-protocol.md §9（协议版本 2）。注意 seq 是【字符串】：它是 uint64，超过 2^53 的值过不了 JS 的 JSON.parse。data_len 是本帧计入 seq 的字节数：OUTPUT / INPUT 是 payload 长度，SNAPSHOT 是 0（快照字节不计入 out_seq）。",
  "binary_frames": [
    {
      "name": "output_basic",
      "hex": "0100000100000000000000e86869",
      "decoded": {
        "type": 1,
        "flags": 0,
        "sid": 1,
        "seq": "232",
        "payload_hex": "6869"
      },
      "data_len": 2
    },
    {
      "name": "snapshot_more",
      "hex": "0301000100000000000000e81b5b48",
      "decoded": {
        "type": 3,
        "flags": 1,
        "sid": 1,
        "seq": "232",
        "payload_hex": "1b5b48"
      },
      "data_len": 0,
      "note": "flags bit0 = MORE：同一份快照后面还有帧。SNAPSHOT 的 seq 是快照对应的 out_seq，快照字节不计入 out_seq"
    },
    {
      "name": "snapshot_last",
      "hex": "0300000100000000000000e81b5b324a",
      "decoded": {
        "type": 3,
        "flags": 0,
        "sid": 1,
        "seq": "232",
        "payload_hex": "1b5b324a"
      },
      "data_len": 0,
      "note": "一份快照的最后一帧（或唯一一帧）：MORE 位为 0。收齐后 terminal.reset() → 换解码器 → 写入 → out_seq = seq"
    },
    {
      "name": "input_basic",
      "hex": "020000030000000000000000617364",
      "decoded": {
        "type": 2,
        "flags": 0,
        "sid": 3,
        "seq": "0",
        "payload_hex": "617364"
      },
      "data_len": 3
    },
    {
      "name": "output_seq_max",
      "hex": "010000ffffffffffffffffff41",
      "decoded": {
        "type": 1,
        "flags": 0,
        "sid": 255,
        "seq": "18446744073709551615",
        "payload_hex": "41"
      },
      "data_len": 1,
      "note": "seq = MaxUint64 边界"
    },
    {
      "name": "output_sid_zero",
      "hex": "0100000000000000000000012a",
      "decoded": {
        "type": 1,
        "flags": 0,
        "sid": 0,
        "seq": "1",
        "payload_hex": "2a"
      },
      "data_len": 1,
      "note": "sid=0 在帧编解码层是合法的；它作为无效值的语义由会话层负责"
    },
    {
      "name": "output_binary_payload",
      "hex": "0100000700000000000f4240e4b8ade696870aff00fe",
      "decoded": {
        "type": 1,
        "flags": 0,
        "sid": 7,
        "seq": "1000000",
        "payload_hex": "e4b8ade696870aff00fe"
      },
      "data_len": 10,
      "note": "payload 可以是任意字节序列，包括非法 UTF-8（ff 00 fe）"
    },
    {
      "name": "output_reserved_flag_ignored",
      "hex": "0101000100000000000000e86869",
      "decoded": {
        "type": 1,
        "flags": 1,
        "sid": 1,
        "seq": "232",
        "payload_hex": "6869"
      },
      "data_len": 2,
      "note": "bit0 只对 SNAPSHOT 有意义；OUTPUT 上的保留位接收方忽略，不是错误"
    }
